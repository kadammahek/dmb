
#include <iostream>
#include <cstdlib>
#include <ctime>
#include <algorithm>
using namespace std;

// Partition function
int partitionArray(int arr[], int low, int high)
{
    int pivot = arr[high];
    int i = low - 1;

    for (int j = low; j < high; j++)
    {
        if (arr[j] < pivot)
        {
            i++;
            swap(arr[i], arr[j]);
        }
    }

    swap(arr[i + 1], arr[high]);

    return i + 1;
}

// Deterministic Quick Sort
void quickSort(int arr[], int low, int high)
{
    if (low < high)
    {
        int pi = partitionArray(arr, low, high);

        quickSort(arr, low, pi - 1);
        quickSort(arr, pi + 1, high);
    }
}

// Randomized Partition
int randomizedPartition(int arr[], int low, int high)
{
    int randomIndex =
        low + rand() % (high - low + 1);

    swap(arr[randomIndex], arr[high]);

    return partitionArray(arr, low, high);
}

// Randomized Quick Sort
void randomizedQuickSort(int arr[], int low, int high)
{
    if (low < high)
    {
        int pi = randomizedPartition(arr, low, high);

        randomizedQuickSort(arr, low, pi - 1);
        randomizedQuickSort(arr, pi + 1, high);
    }
}

// Display sorted array
void display(int arr[], int n)
{
    for (int i = 0; i < n; i++)
    {
        cout << arr[i] << " ";
    }
    cout << endl;
}

int main()
{
    int n;

    cout << "Enter number of elements: ";
    cin >> n;

    if (n <= 0)
    {
        cout << "Invalid array size.";
        return 0;
    }

    // Dynamic memory allocation
    int *arr1 = new int[n];
    int *arr2 = new int[n];

    cout << "Enter array elements: ";

    for (int i = 0; i < n; i++)
    {
        cin >> arr1[i];
        arr2[i] = arr1[i];
    }

    // Initialize random number generator
    srand(time(0));

    // Apply Deterministic Quick Sort
    quickSort(arr1, 0, n - 1);

    // Apply Randomized Quick Sort
    randomizedQuickSort(arr2, 0, n - 1);

    cout << "\nDeterministic Quick Sort:\n";
    display(arr1, n);

    cout << "\nRandomized Quick Sort:\n";
    display(arr2, n);

    // Free allocated memory
    delete[] arr1;
    delete[] arr2;

    return 0;
}

